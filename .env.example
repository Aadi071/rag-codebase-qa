# Copy to .env and edit. .env is gitignored.

# ===========================================================================
# LOCAL (default) — fully free, fully offline: bge-base embeddings + Ollama.
# ===========================================================================

# --- Embeddings: "local" (free bge-base) or "openai" (any OpenAI-compatible) ---
EMBEDDING_BACKEND=local

# --- Answer LLM: "ollama" (free local), "anthropic", or "openai" ---
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Optional: sharper retrieval via a cross-encoder re-ranker (slower).
# RERANK=true

# ===========================================================================
# DEPLOYED — free $0 path via Google Gemini (one key covers chat + embeddings).
# Uncomment this block, comment the LOCAL lines above. See DEPLOYMENT.md.
# Get a key at https://aistudio.google.com/apikey
# ===========================================================================
# EMBEDDING_BACKEND=openai
# LLM_BACKEND=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIza-your-gemini-key
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# EMBEDDING_DIMENSIONS=768
# OPENAI_CHAT_MODEL=gemini-2.0-flash
# EMBEDDING_BATCH_SIZE=100          # drop to 1 if Gemini rejects batched inputs
# ALLOW_INDEXING=false              # after seeding the demo repo

# --- Paid alternatives (unchanged) ---
# Real OpenAI:  EMBEDDING_BACKEND=openai, LLM_BACKEND=openai, OPENAI_API_KEY=sk-...
#               (leave OPENAI_BASE_URL unset; defaults to 1536-dim text-embedding-3-small)
# Anthropic:    LLM_BACKEND=anthropic, ANTHROPIC_API_KEY=sk-ant-...
