# Copy to .env and edit. .env is gitignored.

# --- Embeddings: "local" (free bge-base) or "openai" ---
EMBEDDING_BACKEND=local
OPENAI_API_KEY=sk-your-key-here          # only if EMBEDDING_BACKEND/LLM=openai

# --- Answer LLM: "ollama" (free local), "anthropic", or "openai" ---
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...            # only if LLM_BACKEND=anthropic

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
